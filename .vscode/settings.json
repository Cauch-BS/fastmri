{
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/.git": true,
        "**/.pyc": true,
        "**/__pycache__": true,
        "**/.ipynb_checkpoints": true,
        "**/.hypothesis": true,
        "**/.obsidian": true
    },
    "git.requireGitUserConfig": false,
    "editor.tabSize": 4,
    "editor.wordWrap": "on",
    "python.defaultInterpreterPath": "$HOME/micromamba/envs/msk-attn/bin/python",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
}